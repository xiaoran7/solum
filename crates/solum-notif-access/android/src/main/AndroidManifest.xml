<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ package visibility: the source picker only queries apps
         with a launcher activity; it never requests QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application>
        <!-- F20: keeps the app process hosting Tauri/Rust alive so the
             resident ticker can drain and batch notification captures. -->
        <service
            android:name=".NotificationPipelineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
