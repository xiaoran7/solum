SOLUM_PORT=8787
SOLUM_DB_PATH=/data/solum-cloud.db
SOLUM_AUTH_SECRET=CHANGE-ME
SOLUM_ADMIN_USERNAME=admin
SOLUM_ADMIN_PASSWORD=CHANGE-ME
MIMO_API_KEY=configure-the-token-plan-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
SOLUM_DEFAULT_MODEL=mimo-v2.5
# Comma-separated exact browser origins allowed to call login/refresh.
SOLUM_ALLOWED_ORIGINS=https://solumsync.example.com

# Legacy PA_* names are still accepted for existing deployments.
