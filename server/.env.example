SOLUM_PORT=8787
SOLUM_AUTH_SECRET=CHANGE-ME
SOLUM_ADMIN_USERNAME=admin
SOLUM_ADMIN_PASSWORD=CHANGE-ME
SOLUM_DB_OWNER_PASSWORD=CHANGE-ME-OWNER
SOLUM_DB_APP_PASSWORD=CHANGE-ME-APP
SOLUM_DB_POOL_MAX=10
SOLUM_SYNC_RETENTION_DAYS=30
SOLUM_ALERT_RETENTION_DAYS=7
SOLUM_HOST_PORT=8787
SOLUM_REGISTRATION_MODE=open
MIMO_API_KEY=configure-the-token-plan-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
SOLUM_DEFAULT_MODEL=mimo-v2.5
# Comma-separated exact browser origins allowed to call login/refresh.
SOLUM_ALLOWED_ORIGINS=https://solumsync.example.com

# Legacy PA_* names are still accepted for existing deployments.
# SOLUM_DB_PATH=/data/solum-cloud.db is SQLite-only and retained for migration tools/tests.
